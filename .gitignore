Local.xcconfig
*.local.xcconfig

# MML api-key (never commit)
Secrets.xcconfig

# CocoaPods / SPM caches
Pods/
.build/

# macOS
.DS_Store
**/.DS_Store

# Superpowers visual companion
.superpowers/
